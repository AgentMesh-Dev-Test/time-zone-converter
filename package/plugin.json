          "convert-a-date-and-time": {
            "scripts": [
              "scripts/convert-a-date-and-time.mjs"
            ]
          }
        }
      },
      "descriptor": {
        "path": "agent-descriptor.json",
        "sha256": "28d9052a566d8d0b1025c92446e4c90d58bb7c2f5340c631694b8501501b92c6"
      },
