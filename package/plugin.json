              "scripts/convert-a-date-and-time.mjs"
            ]
          }
        }
      },
      "descriptor": {
        "path": "agent-descriptor.json",
        "sha256": "15606c92db910631b60053858d254f76fff6b46666418348f74a28798d3b97de"
